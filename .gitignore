# checkpoints / outputs (regenerable, can be large)
out*/
*.pt
*.jsonl
curves.png
eval.json

# ...except the artefacts that are committed ON PURPOSE: the trained ~7M-param
# checkpoint (~28 MB fp32 / ~12 MB INT8) that CPU-only inference loads via
# generate.py / run.ps1, and the config/eval files that document the run.
# Rule order matters: git cannot re-include a file whose parent directory is
# still excluded, so `out/` itself must be un-ignored first. Everything else
# under out/ (opt.pt, intermediate checkpoints) stays ignored.
!out/
!out/config.txt
!out/config.json
!out/eval.json
!out/log.jsonl
!out/MODEL_CARD.md
!out/model_best.pt
!out/model_best_int8.pt
!out/model_chat.pt
!out/model_chat_config.json
!out/chat_log.jsonl
!out/chat_run_config.json
!out/model_15m_best.pt
!out/model_15m_best_config.json
!out/model_15m_chat.pt
!out/model_15m_chat_config.json
!out/model_15m_chat_int8.pt
!out/model_15m_best_int8.pt

# Small, deterministic instruction-tuning corpus (generated by 07_make_sft.py).
!data/sft/chat_sft.jsonl

# tokenised blocks: regenerated by 02_preprocess.py from the committed corpus
# (see README "Reproduce from scratch"); the corpus itself IS committed.
data/packed/

# Downloaded external model weights (can be several GB; never commit these)
models/*.gguf

# logs
*.log

# python
__pycache__/
*.pyc
.venv/
